{
  "name": "expo-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build": "npx expo export --platform web && cp public/manifest.json dist/ && cp public/service-worker.js dist/ && cp public/mobilet.png dist/ && node pwa-inject.js"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0"
  },
  "private": true
}
